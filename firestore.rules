rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

// =================================================================
// Helper Functions
// These make the rules below cleaner and easier to read.
// =================================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    // Checks if the requesting user is the owner of the document.
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Checks if the user has a specific role using custom claims
    function isUserRole() {
      return isAuthenticated() && request.auth.token.role == 'user';
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'admin';
    }

    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.role == 'superadmin';
    }

    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function isVerifiedUser() {
      return isAuthenticated() && getUserData(request.auth.uid).verificationStatus == 'verified';
    }

    // Checks if the user is an admin for a specific barangay.
    // This assumes the admin's assigned barangayId is stored in custom claims
    function isAdminOfBarangay(barangayId) {
      return isAdmin() && request.auth.token.barangayId == barangayId;
    }

// =================================================================
// Collection: users
// Stores public user profile information.
// =================================================================
    match /users/{userId} {
      // READ: Users can read their own profile. Admins can read profiles of users in their barangay. Super admins can read other admins/super admins.
      allow read: if isOwner(userId) ||
                    (isAdmin() && resource.data.barangayId == request.auth.token.barangayId) ||
                    (isSuperAdmin() && (resource.data.role == 'admin' || resource.data.role == 'superadmin'));

      // CREATE: Allow user creation during registration. The document ID must match the UID
      // and the role must be set to 'user'. We also validate required fields.
      allow create: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.role == 'user'
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.email is string
                    && request.resource.data.name is string;

      // UPDATE: A user can update their own profile to submit full registration.
      // Once verified, they cannot change their profile data.
      // An admin can update the verificationStatus to 'verified' or 'rejected' with rejectionReason.
      allow update: if (isOwner(userId) && resource.data.verificationStatus != 'verified') ||
                    (isAdmin() && resource.data.barangayId == request.auth.token.barangayId &&
                     ((request.resource.data.keys().hasOnly(['verificationStatus']) && request.resource.data.verificationStatus == 'verified') ||
                      (request.resource.data.keys().hasAll(['verificationStatus', 'rejectionReason']) && request.resource.data.verificationStatus == 'rejected'))) ||
                    (isSuperAdmin() && request.resource.data.role == 'admin' && request.resource.data.keys().hasOnly(['barangayId']));

      // DELETE: Disallowed from client. Handle through a Cloud Function if needed.
      allow delete: if false;

      // Subcollection: notifications
      match /notifications/{notificationId} {
        allow read: if isOwner(userId); // Only the owner can read their notifications
        allow write: if false; // Notifications are written by Cloud Functions, not directly by clients
      }
    }

// =================================================================
// Collection: announcements
// Managed by Admins and Super Admins.
// =================================================================
    match /announcements/{announcementId} {
      // READ: Users can read announcements from their barangayId. Admins can read announcements from their barangay. Super admins can read all announcements.
      allow read: if (isUserRole() && isVerifiedUser() && resource.data.barangayId == getUserData(request.auth.uid).barangayId) ||
                     (isAdmin() && resource.data.barangayId == request.auth.token.barangayId) ||
                     isSuperAdmin();

      // CREATE: Admins can create announcements for their barangay. Super admins can create announcements for any barangay.
      allow create: if (isAdmin() && request.resource.data.barangayId == request.auth.token.barangayId) ||
                       isSuperAdmin();

      // UPDATE: Admins can update announcements from their barangay. Super admins can update any announcement.
      allow update: if (isAdmin() && resource.data.barangayId == request.auth.token.barangayId) ||
                       isSuperAdmin();

      // DELETE: Admins can delete announcements from their barangay. Super admins can delete any announcement.
      allow delete: if (isAdmin() && resource.data.barangayId == request.auth.token.barangayId) ||
                       isSuperAdmin();
    }

// =================================================================
// Collection: medicine
// Managed by Super Admins for inventory.
// =================================================================
    match /medicine/{medicineId} {
      // READ: Users can read medicine inventory. Admins and Super admins can read all medicine records.
      allow read: if (isUserRole() && isVerifiedUser()) || isAdmin() || isSuperAdmin();

      // CREATE: Super admins can create medicine records.
      allow create: if isSuperAdmin();

      // UPDATE: Super admins can update medicine records.
      allow update: if isSuperAdmin();

      // DELETE: Super admins can delete medicine records.
      allow delete: if isSuperAdmin();
    }

// =================================================================
// Collection: medicineRequests
// Users can create requests. Admins can view requests from their barangay. Superadmins can view all.
// =================================================================
    match /medicineRequests/{requestId} {
      allow create: if isUserRole() && isVerifiedUser() && request.resource.data.userId == request.auth.uid
                    && request.resource.data.medicineId is string
                    && request.resource.data.barangayId == getUserData(request.auth.uid).barangayId
                    && request.resource.data.status == 'pending'
                    && request.resource.data.createdAt == request.time;

      allow read: if (isUserRole() && resource.data.userId == request.auth.uid) ||
                   (isAdmin() && resource.data.barangayId == request.auth.token.barangayId) ||
                   isSuperAdmin();

      allow update: if (isUserRole() && resource.data.userId == request.auth.uid && resource.data.status == 'accepted' && request.resource.data.status == 'completed') ||
                     (isUserRole() && resource.data.userId == request.auth.uid && resource.data.status == 'pending' && request.resource.data.status == 'cancelled') ||
                     (isAdmin() && resource.data.barangayId == request.auth.token.barangayId) ||
                     isSuperAdmin()
                    && resource.data.status == 'pending'
                    && request.resource.data.status in ['accepted', 'rejected'];

      allow delete: if false; // Deletion not allowed from client
    }

// =================================================================
// Collection: teleconsultationRequests
// Users can create teleconsultation requests. Superadmins can manage them.
// =================================================================
    match /teleconsultationRequests/{requestId} {
      // CREATE: Verified users can create teleconsultation requests
      allow create: if isUserRole() && isVerifiedUser() && request.resource.data.userId == request.auth.uid
                    && request.resource.data.reason is string
                    && request.resource.data.status == 'pending'
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.updatedAt == request.time
                    && request.resource.data.userEmail is string
                    && request.resource.data.userName is string;

      // READ: Users can read their own requests. Superadmins can read all requests.
      allow read: if (isUserRole() && resource.data.userId == request.auth.uid) ||
                   isSuperAdmin();

      // UPDATE: Users can cancel pending requests or mark accepted requests as completed.
      // Superadmins can update any request to any valid status.
      allow update: if (isUserRole() && resource.data.userId == request.auth.uid &&
                        ((resource.data.status == 'pending' && request.resource.data.status == 'cancelled') ||
                         (resource.data.status == 'accepted' && request.resource.data.status == 'completed'))) ||
                    (isSuperAdmin() && request.resource.data.status in ['pending', 'cancelled', 'accepted', 'rejected', 'scheduled', 'completed', 'no show']);

      // DELETE: Deletion not allowed from client
      allow delete: if false;
    }

// =================================================================
// Collection: logs
// Users can create log entries for tracking activities.
// =================================================================
    match /logs/{logId} {
      // READ: Users can read their own logs. Admins and Super admins can read all logs.
      allow read: if (isUserRole() && resource.data.userId == request.auth.uid) ||
                   isAdmin() || isSuperAdmin();

      // CREATE: Authenticated users can create log entries.
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid
                    && request.resource.data.action is string
                    && request.resource.data.timestamp == request.time;

      // UPDATE: Only admins and super admins can update logs.
      allow update: if isAdmin() || isSuperAdmin();

      // DELETE: Only super admins can delete logs.
      allow delete: if isSuperAdmin();
    }

  }
}
