rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =================================================================
    // Helper Functions
    // These make the rules below cleaner and easier to read.
    // =================================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    // Checks if the requesting user is the owner of the document.
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Checks if the user has a specific role using custom claims
    function isUserRole() {
      return isAuthenticated() && request.auth.token.role == 'user';
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'admin';
    }

    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.role == 'superadmin';
    }

    // Checks if the user is an admin for a specific barangay.
    // This assumes the admin's assigned barangayId is stored in custom claims
    function isAdminOfBarangay(barangayId) {
      return isAdmin() && request.auth.token.barangayId == barangayId;
    }

    // =================================================================
    // Collection: users
    // Stores public user profile information.
    // =================================================================
    match /users/{userId} {
      // READ: Users can read their own profile. Admins can read profiles of users in their barangay. Super admins can read other admins/super admins.
      allow read: if isOwner(userId) ||
                     (isAdmin() && resource.data.barangayId == request.auth.token.barangayId) ||
                     (isSuperAdmin() && (resource.data.role == 'admin' || resource.data.role == 'superadmin'));

      // CREATE: Allow user creation during registration. The document ID must match the UID
      // and the role must be set to 'user'. We also validate required fields.
      allow create: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.role == 'user'
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.email is string
                    && request.resource.data.name is string;

      // UPDATE: A user can update their own profile, but cannot change their UID or role.
      allow update: if isOwner(userId)
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.role == resource.data.role;

      // DELETE: Disallowed from client. Handle through a Cloud Function if needed.
      allow delete: if false;
    }

    // =================================================================
    // Collection: medicineRequests
    // Stores requests for medicine from users.
    // =================================================================
    match /medicineRequests/{requestId} {
      // READ: The owner or the admin of the barangay can read.
      allow read: if isOwner(resource.data.userId) || isAdminOfBarangay(resource.data.barangayId);

      // CREATE: A user can create a request for themselves. Validate required fields.
      allow create: if isOwner(request.resource.data.userId) && isUserRole()
                    && request.resource.data.status == 'pending'
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.medicines is list
                    && request.resource.data.barangayId is string;

      // UPDATE: A user can cancel their own pending request. An admin can update the status of a request in their barangay.
      allow update: if (isOwner(resource.data.userId) && request.resource.data.status == 'cancelled' && resource.data.status == 'pending') ||
                       (isAdminOfBarangay(resource.data.barangayId) && request.resource.data.keys().hasOnly(['status']));

      // DELETE: Disallowed. Users should update status to 'cancelled'.
      allow delete: if false;
    }

    // =================================================================
    // Collection: medicineTransfers
    // Stores requests for medicine stock transfers from admins.
    // =================================================================
    match /medicineTransfers/{transferId} {
      // READ: The requesting admin or any super admin can read.
      allow read: if isAdminOfBarangay(resource.data.barangayId) || isSuperAdmin();

      // CREATE: An admin can create a transfer request for their own barangay.
      allow create: if isAdminOfBarangay(request.resource.data.barangayId)
                    && request.resource.data.status == 'pending'
                    && request.resource.data.createdAt == request.time;

      // UPDATE: The requesting admin can cancel. Super admins can update status (e.g., to fulfill).
      allow update: if (isAdminOfBarangay(resource.data.barangayId) && request.resource.data.status == 'cancelled' && resource.data.status == 'pending') ||
                       (isSuperAdmin() && request.resource.data.keys().hasOnly(['status']));

      // DELETE: Disallowed.
      allow delete: if false;
    }

    // =================================================================
    // Collection: teleconsultationRequests
    // Stores requests for tele-consultations from users.
    // =================================================================
    match /teleconsultationRequests/{teleRequestId} {
      // READ: The owner or the admin of the barangay can read.
      allow read: if isOwner(resource.data.userId) || isAdminOfBarangay(resource.data.barangayId);

      // CREATE: A user can create a request for themselves.
      allow create: if isOwner(request.resource.data.userId) && isUserRole()
                    && request.resource.data.status == 'pending'
                    && request.resource.data.symptoms is string;

      // UPDATE: An admin can update the status. A user can cancel their own pending request.
      allow update: if (isOwner(resource.data.userId) && request.resource.data.status == 'cancelled' && resource.data.status == 'pending') ||
                       (isAdminOfBarangay(resource.data.barangayId) && request.resource.data.keys().hasOnly(['status']));

      // DELETE: Disallowed.
      allow delete: if false;
    }

    // =================================================================
    // Collection: teleconsultationSchedules
    // Stores available dates for tele-consultations.
    // =================================================================
    match /teleconsultationSchedules/{scheduleId} {
      // READ: Any authenticated user can read schedules to book an appointment.
      allow read: if isAuthenticated();
      // WRITE: Only super admins can create, update, or delete schedules.
      allow write: if isSuperAdmin();
    }

    // =================================================================
    // Collection: medicalRecords
    // Stores user medical records. Created and managed by admins.
    // =================================================================
    match /medicalRecords/{recordId} {
      // READ: The patient (owner) or the admin of the barangay.
      allow read: if isOwner(resource.data.userId) || isAdminOfBarangay(resource.data.barangayId);

      // WRITE: Only admins of the corresponding barangay or super admins can create/update records.
      allow write: if isAdminOfBarangay(request.resource.data.barangayId) || isSuperAdmin();

      // DELETE: Disallowed.
      allow delete: if false;
    }

    // =================================================================
    // Collection: medicines (Global Inventory)
    // Managed by Super Admins.
    // =================================================================
    match /medicines/{medicineId} {
      // READ: Any authenticated user can see the list of all possible medicines.
      allow read: if isAuthenticated();
      // WRITE: Only Super Admins can add, update, or remove from the global list.
      allow write: if isSuperAdmin();
    }

    // =================================================================
    // Collection: rhuInventory (RHU/Barangay-specific Inventory)
    // Managed by Admins for their own barangay.
    // =================================================================
    match /rhuInventory/{barangayId}/{medicineId} {
      // READ: Users can read their own barangay's inventory. Admins can read their own. Super admins can read all.
      allow read: if (isUserRole() && barangayId == request.auth.token.barangayId) ||
                     isAdminOfBarangay(barangayId) ||
                     isSuperAdmin();

      // WRITE: Only the admin of that barangay or a super admin can manage inventory.
      allow write: if isAdminOfBarangay(barangayId) || isSuperAdmin();
    }

    // =================================================================
    // Collection: announcements
    // Managed by Admins and Super Admins.
    // =================================================================
    match /announcements/{announcementId} {
      // READ: Users can read announcements from their barangay. Admins can read announcements from their barangay. Super admins can read all announcements.
      allow read: if isAuthenticated() && 
                     ((isUserRole() && resource.data.barangay == request.auth.token.barangayId) ||
                      (isAdmin() && resource.data.barangay == request.auth.token.barangayId) ||
                      isSuperAdmin());
      
      // CREATE: Admins can create announcements for their barangay. Super admins can create announcements for any barangay.
      allow create: if (isAdmin() && request.resource.data.barangay == request.auth.token.barangayId) ||
                       isSuperAdmin();
      
      // UPDATE: Admins can update announcements from their barangay. Super admins can update any announcement.
      allow update: if (isAdmin() && resource.data.barangay == request.auth.token.barangayId) ||
                       isSuperAdmin();
      
      // DELETE: Admins can delete announcements from their barangay. Super admins can delete any announcement.
      allow delete: if (isAdmin() && resource.data.barangay == request.auth.token.barangayId) ||
                       isSuperAdmin();
    }

    // =================================================================
    // Collection: logs
    // Stores system activity logs and notifications.
    // =================================================================
    match /logs/{logId} {
      // READ: Users can read their own logs. Admins can read logs for users in their barangay. Super admins can read all logs.
      allow read: if isOwner(resource.data.userId) ||
                     (isAdmin() && resource.data.barangayId == request.auth.token.barangayId) ||
                     isSuperAdmin();

      // WRITE: Only allow writes through Cloud Functions or specific authorized processes.
      // Client-side writes are restricted to prevent unauthorized log creation.
      allow write: if false;
    }
  }
}
