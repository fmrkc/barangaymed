[debug] [2025-09-28T08:13:50.824Z] >>> [apiv2][body] PUT http://127.0.0.1:8081/emulator/v1/projects/barangaymed:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\r\n\r\nservice cloud.firestore {\r\n  match /databases/{database}/documents {\r\n\r\n// =================================================================\r\n// Helper Functions\r\n// These make the rules below cleaner and easier to read.\r\n// =================================================================\r\n    function isAuthenticated() {\r\n      return request.auth != null;\r\n    }\r\n\r\n    // Checks if the requesting user is the owner of the document.\r\n    function isOwner(userId) {\r\n      return isAuthenticated() && request.auth.uid == userId;\r\n    }\r\n\r\n    // Checks if the user has a specific role using custom claims\r\n    function isUserRole() {\r\n      return isAuthenticated() && request.auth.token.role == 'user';\r\n    }\r\n\r\n    function isAdmin() {\r\n      return isAuthenticated() && request.auth.token.role == 'admin';\r\n    }\r\n\r\n    function isSuperAdmin() {\r\n      return isAuthenticated() && request.auth.token.role == 'superadmin';\r\n    }\r\n\r\n    function isVerifiedResident() {\r\n      return isUserRole() && request.auth.token.verificationStatus == 'verified';\r\n    }\r\n\r\n    // Checks if the user is an admin for a specific barangay.\r\n    // This assumes the admin's assigned barangayId is stored in custom claims\r\n    function isAdminOfBarangay(barangayId) {\r\n      return isAdmin() && request.auth.token.barangayId == barangayId;\r\n    }\r\n\r\n    match /{path=**}/full_registration/{attemptId} {\r\n      allow read: if isAdmin() && resource.data.barangayId == request.auth.token.barangayId;\r\n    }\r\n\r\n// =================================================================\r\n// Collection: users\r\n// Stores public user profile information.\r\n// =================================================================\r\n    match /users/{userId} {\r\n      // READ: Users can read their own profile. Admins can read profiles of users in their barangay. Super admins can read other admins/super admins.\r\n      allow read: if isOwner(userId) ||\r\n                    (isAdmin() && resource.data.barangayId == request.auth.token.barangayId) ||\r\n                    (isSuperAdmin() && (resource.data.role == 'admin' || resource.data.role == 'superadmin'));\r\n\r\n      // CREATE: Allow user creation during registration.\r\n      allow create: if request.auth != null && request.auth.uid == userId\r\n                    && request.resource.data.role == 'user';\r\n\r\n      // UPDATE: A user can update their own non-sensitive info. Admins/SuperAdmins have their own backend functions for updates.\r\n      allow update: if isOwner(userId) &&\r\n                    request.resource.data.keys().hasOnly([\r\n                      'firstName', 'lastName', 'email', 'address', 'contactNumber',\r\n                      'selectedRegion', 'selectedProvince', 'selectedCityMunicipality', 'barangayId',\r\n                      'zipCode', 'lotBlkHouseNo', 'streetName', 'subdivisionVillageZonePurok',\r\n                      'idVerificationUrl', 'idVerificationType', 'rejectionReason', 'verificationStatus'\r\n                    ]) &&\r\n                    // Prevent users from changing their own role or verification status directly.\r\n                    request.resource.data.role == resource.data.role;\r\n\r\n      // DELETE: Disallowed from client.\r\n      allow delete: if false;\r\n\r\n      // Subcollection: full_registration\r\n      match /full_registration/{attemptId} {\r\n        allow get: if isOwner(userId) ||\r\n                      (isAdmin() && resource.data.barangayId == request.auth.token.barangayId) ||\r\n                      isSuperAdmin();\r\n        allow list: if isOwner(userId) ||\r\n                       (isAdmin() && resource.data.barangayId == request.auth.token.barangayId) ||\r\n                       isSuperAdmin();\r\n\r\n        allow create: if isOwner(userId);\r\n\r\n        allow update: if (isAdmin() && resource.data.barangayId == request.auth.token.barangayId) ||\r\n                        isSuperAdmin();\r\n      }\r\n\r\n      // Subcollection: notifications\r\n      match /notifications/{notificationId} {\r\n        allow read: if isOwner(userId);\r\n        allow create: if isOwner(userId) || isSuperAdmin();\r\n        allow update, delete: if false;\r\n      }\r\n\r\n      // Subcollection: logs\r\n      match /logs/{logId} {\r\n        allow read, write: if false; // Written by backend services only\r\n      }\r\n    }\r\n\r\n// =================================================================\r\n// Collection: announcements\r\n// Managed by Admins and Super Admins.\r\n// =================================================================\r\n    match /announcements/{announcementId} {\r\n      // READ: Users can read announcements from their barangayId. Admins can read announcements from their barangay. Super admins can read all announcements.\r\n      allow read: if (isVerifiedResident() && resource.data.barangayId == request.auth.token.barangayId) ||\r\n                     (isAdmin() && resource.data.barangayId == request.auth.token.barangayId) ||\r\n                     isSuperAdmin();\r\n\r\n      // CREATE: Admins can create announcements for their barangay. Super admins can create announcements for any barangay.\r\n      allow create: if (isAdmin() && request.resource.data.barangayId == request.auth.token.barangayId) ||\r\n                       isSuperAdmin();\r\n\r\n      // UPDATE: Admins can update announcements from their barangay. Super admins can update any announcement.\r\n      allow update: if (isAdmin() && resource.data.barangayId == request.auth.token.barangayId) ||\r\n                       isSuperAdmin();\r\n\r\n      // DELETE: Admins can delete announcements from their barangay. Super admins can delete any announcement.\r\n      allow delete: if (isAdmin() && resource.data.barangayId == request.auth.token.barangayId) ||\r\n                       isSuperAdmin();\r\n    }\r\n\r\n// =================================================================\r\n// Collection: medicine\r\n// Managed by Super Admins for inventory.\r\n// =================================================================\r\n    match /medicine/{medicineId} {\r\n      // READ: Users can read medicine inventory. Admins and Super admins can read all medicine records.\r\n      allow read: if isVerifiedResident() || isAdmin() || isSuperAdmin();\r\n\r\n      // CREATE: Super admins can create medicine records.\r\n      allow create: if isSuperAdmin();\r\n\r\n      // UPDATE: Super admins can update medicine records.\r\n      allow update: if isSuperAdmin();\r\n\r\n      // DELETE: Super admins can delete medicine records.\r\n      allow delete: if isSuperAdmin();\r\n    }\r\n\r\n// =================================================================\r\n// Collection: medicineRequests\r\n// Users can create requests. Admins can view requests from their barangay. Superadmins can view all.\r\n// =================================================================\r\n    match /medicineRequests/{requestId} {\r\n      allow create: if isVerifiedResident() && request.resource.data.userId == request.auth.uid\r\n                    && request.resource.data.medicineId is string\r\n                    && request.resource.data.barangayId == request.auth.token.barangayId\r\n                    && request.resource.data.status == 'pending'\r\n                    && request.resource.data.createdAt == request.time;\r\n\r\n      allow read: if (isUserRole() && resource.data.userId == request.auth.uid) ||\r\n                   (isAdmin() && resource.data.barangayId == request.auth.token.barangayId) ||\r\n                   isSuperAdmin();\r\n\r\n      allow update: if (isUserRole() && resource.data.userId == request.auth.uid && resource.data.status == 'accepted' && request.resource.data.status == 'completed') ||\r\n                     (isUserRole() && resource.data.userId == request.auth.uid && resource.data.status == 'pending' && request.resource.data.status == 'cancelled') ||\r\n                     (isAdmin() && resource.data.barangayId == request.auth.token.barangayId) ||\r\n                     isSuperAdmin()\r\n                    && resource.data.status == 'pending'\r\n                    && request.resource.data.status in ['accepted', 'rejected'];\r\n\r\n      allow delete: if false; // Deletion not allowed from client\r\n    }\r\n\r\n// =================================================================\r\n// Collection: teleconsultationRequests\r\n// Users can create teleconsultation requests. Admins and Superadmins can manage them.\r\n// =================================================================\r\n    match /teleconsultationRequests/{requestId} {\r\n      // CREATE: Verified users can create teleconsultation requests for themselves only\r\n      allow create: if isVerifiedResident()\r\n                    && request.resource.data.userId == request.auth.uid\r\n                    && request.resource.data.barangayId is string\r\n                    && request.resource.data.reason is string\r\n                    && request.resource.data.status == 'pending';\r\n\r\n      // READ: Users can read their own requests. Admins can read requests from their barangay. Superadmins can read all requests.\r\n      allow read: if (isUserRole() && resource.data.userId == request.auth.uid) ||\r\n                   (isAdmin() && resource.data.barangayId == request.auth.token.barangayId) ||\r\n                   isSuperAdmin();\r\n\r\n      // UPDATE: Users can cancel pending requests or mark accepted requests as completed.\r\n      // Admins can update requests in their barangay. Superadmins can update any request to any valid status.\r\n      allow update: if (isUserRole() && resource.data.userId == request.auth.uid &&\r\n                        ((resource.data.status == 'pending' && request.resource.data.status == 'cancelled') ||\r\n                         (resource.data.status == 'accepted' && request.resource.data.status == 'completed'))) ||\r\n                    (isAdmin() && resource.data.barangayId == request.auth.token.barangayId) ||\r\n                    (isSuperAdmin() && request.resource.data.status in ['pending', 'cancelled', 'accepted', 'rejected', 'scheduled', 'completed', 'no show']);\r\n\r\n      // DELETE: Deletion not allowed from client\r\n      allow delete: if false;\r\n    }\r\n\r\n// =================================================================\r\n// Collection: logs\r\n// Users can create log entries for tracking activities.\r\n// =================================================================\r\n    match /logs/{logId} {\r\n      // READ: Users can read their own logs. Admins and Super admins can read all logs.\r\n      allow read: if (isUserRole() && resource.data.userId == request.auth.uid) ||\r\n                   isAdmin() || isSuperAdmin();\r\n\r\n      // CREATE: Authenticated users can create log entries.\r\n      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid\r\n                    && request.resource.data.action is string\r\n                    && request.resource.data.timestamp == request.time;\r\n\r\n      // UPDATE: Only admins and super admins can update logs.\r\n      allow update: if isAdmin() || isSuperAdmin();\r\n\r\n      // DELETE: Only super admins can delete logs.\r\n      allow delete: if isSuperAdmin();\r\n    }\r\n\r\n  }\r\n}\r\n"}]}}
