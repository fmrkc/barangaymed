  "main": "lib/index.js",
  "dependencies": {
    "@firebase/auth": "latest",
    "@firebase/functions": "latest",
    "@types/cors": "latest",
    "@types/nodemailer": "latest",
    "@types/uuid": "latest",
    "cors": "latest",
    "firebase-admin": "latest",
    "firebase-functions": "latest",
    "nodemailer": "latest",
    "resend": "latest",
    "uuid": "latest"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "latest",
    "@typescript-eslint/parser": "latest",
    "eslint": "latest",
    "globals": "latest",
    "typescript": "latest"
  },
  "private": true
}
