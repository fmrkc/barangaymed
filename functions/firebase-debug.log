[debug] [2025-08-31T15:43:52.564Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/barangaymed/rulesets {"name":"projects/barangaymed/rulesets/15b440cd-622d-44f6-8cf5-93ffcc319a93","source":{"files":[{"content":"rules_version = '2';\r\n\r\nservice firebase.storage {\r\n  match /b/{bucket}/o {\r\n\r\n    // Helper functions (mirroring firestore.rules)\r\n    function isAuthenticated() {\r\n      return request.auth != null;\r\n    }\r\n\r\n    function isAdmin() {\r\n      return isAuthenticated() && request.auth.token.role == 'admin';\r\n    }\r\n\r\n    function isSuperAdmin() {\r\n      return isAuthenticated() && request.auth.token.role == 'superadmin';\r\n    }\r\n\r\n    function isAdminOfBarangay(barangayId) {\r\n      return isAdmin() && request.auth.token.barangayId == barangayId;\r\n    }\r\n\r\n    // Announcement images:\r\n    // Path: /announcements/{barangayId}/{announcementId}/{imageName}\r\n    match /announcements/{barangayId}/{announcementId}/{imageName} {\r\n      // READ: Anyone can view announcement images (public content).\r\n      allow read: if true;\r\n\r\n      // WRITE (Create, Update, Delete):\r\n      // Only the admin of the corresponding barangay or a superadmin can upload/delete images.\r\n      allow write: if isAdminOfBarangay(barangayId) || isSuperAdmin();\r\n    }\r\n\r\n    // Other potential storage paths can be added here later.\r\n    // Example for user profile pictures:\r\n    // match /users/{userId}/profile-picture.jpg {\r\n    //   allow read: if true;\r\n    //   allow write: if request.auth.uid == userId;\r\n    // }\r\n  }\r\n}\r\n","name":"storage.rules"}]},"createTime":"2025-08-31T15:43:54.303935Z","metadata":{"services":["firebase.storage"]}}
