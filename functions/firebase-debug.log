[debug] [2025-08-31T15:43:55.285Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/barangaymed/rulesets {"name":"projects/barangaymed/rulesets/ffe5d42c-d91e-4ca2-ab30-762a9f1f6d8c","source":{"files":[{"content":"rules_version = '2';\r\n\r\nservice cloud.firestore {\r\n  match /databases/{database}/documents {\r\n\r\n    // =================================================================\r\n    // Helper Functions\r\n    // These make the rules below cleaner and easier to read.\r\n    // =================================================================\r\n    function isAuthenticated() {\r\n      return request.auth != null;\r\n    }\r\n\r\n    // Checks if the requesting user is the owner of the document.\r\n    function isOwner(userId) {\r\n      return isAuthenticated() && request.auth.uid == userId;\r\n    }\r\n\r\n    // Checks if the user has a specific role using custom claims\r\n    function isUserRole() {\r\n      return isAuthenticated() && request.auth.token.role == 'user';\r\n    }\r\n\r\n    function isAdmin() {\r\n      return isAuthenticated() && request.auth.token.role == 'admin';\r\n    }\r\n\r\n    function isSuperAdmin() {\r\n      return isAuthenticated() && request.auth.token.role == 'superadmin';\r\n    }\r\n\r\n    function getUserData(userId) {\r\n      return get(/databases/$(database)/documents/users/$(userId)).data;\r\n    }\r\n\r\n    // Checks if the user is an admin for a specific barangay.\r\n    // This assumes the admin's assigned barangayId is stored in custom claims\r\n    function isAdminOfBarangay(barangayId) {\r\n      return isAdmin() && request.auth.token.barangayId == barangayId;\r\n    }\r\n\r\n    // =================================================================\r\n    // Collection: users\r\n    // Stores public user profile information.\r\n    // =================================================================\r\n    match /users/{userId} {\r\n      // READ: Users can read their own profile. Admins can read profiles of users in their barangay. Super admins can read other admins/super admins.\r\n      allow read: if isOwner(userId) ||\r\n                     (isAdmin() && resource.data.barangayId == request.auth.token.barangayId) ||\r\n                     (isSuperAdmin() && (resource.data.role == 'admin' || resource.data.role == 'superadmin'));\r\n\r\n      // CREATE: Allow user creation during registration. The document ID must match the UID\r\n      // and the role must be set to 'user'. We also validate required fields.\r\n      allow create: if request.auth != null && request.auth.uid == userId\r\n                    && request.resource.data.role == 'user'\r\n                    && request.resource.data.createdAt == request.time\r\n                    && request.resource.data.email is string\r\n                    && request.resource.data.name is string;\r\n\r\n      // UPDATE: A user can update their own profile, but cannot change their UID or role.\r\n      allow update: if isOwner(userId)\r\n                    && request.resource.data.uid == resource.data.uid\r\n                    && request.resource.data.role == resource.data.role;\r\n\r\n      // DELETE: Disallowed from client. Handle through a Cloud Function if needed.\r\n      allow delete: if false;\r\n    }\r\n\r\n    // =================================================================\r\n    // Collection: medicineRequests\r\n    // Stores requests for medicine from users.\r\n    // =================================================================\r\n    match /medicineRequests/{requestId} {\r\n      // READ: The owner or the admin of the barangay can read.\r\n      allow read: if isOwner(resource.data.userId) || isAdminOfBarangay(resource.data.barangayId);\r\n\r\n      // CREATE: A user can create a request for themselves. Validate required fields.\r\n      allow create: if isOwner(request.resource.data.userId) && isUserRole()\r\n                    && request.resource.data.status == 'pending'\r\n                    && request.resource.data.createdAt == request.time\r\n                    && request.resource.data.medicines is list\r\n                    && request.resource.data.barangayId is string;\r\n\r\n      // UPDATE: A user can cancel their own pending request. An admin can update the status of a request in their barangay.\r\n      allow update: if (isOwner(resource.data.userId) && request.resource.data.status == 'cancelled' && resource.data.status == 'pending') ||\r\n                       (isAdminOfBarangay(resource.data.barangayId) && request.resource.data.keys().hasOnly(['status']));\r\n\r\n      // DELETE: Disallowed. Users should update status to 'cancelled'.\r\n      allow delete: if false;\r\n    }\r\n\r\n    // =================================================================\r\n    // Collection: medicineTransfers\r\n    // Stores requests for medicine stock transfers from admins.\r\n    // =================================================================\r\n    match /medicineTransfers/{transferId} {\r\n      // READ: The requesting admin or any super admin can read.\r\n      allow read: if isAdminOfBarangay(resource.data.barangayId) || isSuperAdmin();\r\n\r\n      // CREATE: An admin can create a transfer request for their own barangay.\r\n      allow create: if isAdminOfBarangay(request.resource.data.barangayId)\r\n                    && request.resource.data.status == 'pending'\r\n                    && request.resource.data.createdAt == request.time;\r\n\r\n      // UPDATE: The requesting admin can cancel. Super admins can update status (e.g., to fulfill).\r\n      allow update: if (isAdminOfBarangay(resource.data.barangayId) && request.resource.data.status == 'cancelled' && resource.data.status == 'pending') ||\r\n                       (isSuperAdmin() && request.resource.data.keys().hasOnly(['status']));\r\n\r\n      // DELETE: Disallowed.\r\n      allow delete: if false;\r\n    }\r\n\r\n    // =================================================================\r\n    // Collection: teleconsultationRequests\r\n    // Stores requests for tele-consultations from users.\r\n    // =================================================================\r\n    match /teleconsultationRequests/{teleRequestId} {\r\n      // READ: The owner or the admin of the barangay can read.\r\n      allow read: if isOwner(resource.data.userId) || isAdminOfBarangay(resource.data.barangayId);\r\n\r\n      // CREATE: A user can create a request for themselves.\r\n      allow create: if isOwner(request.resource.data.userId) && isUserRole()\r\n                    && request.resource.data.status == 'pending'\r\n                    && request.resource.data.symptoms is string;\r\n\r\n      // UPDATE: An admin can update the status. A user can cancel their own pending request.\r\n      allow update: if (isOwner(resource.data.userId) && request.resource.data.status == 'cancelled' && resource.data.status == 'pending') ||\r\n                       (isAdminOfBarangay(resource.data.barangayId) && request.resource.data.keys().hasOnly(['status']));\r\n\r\n      // DELETE: Disallowed.\r\n      allow delete: if false;\r\n    }\r\n\r\n    // =================================================================\r\n    // Collection: teleconsultationSchedules\r\n    // Stores available dates for tele-consultations.\r\n    // =================================================================\r\n    match /teleconsultationSchedules/{scheduleId} {\r\n      // READ: Any authenticated user can read schedules to book an appointment.\r\n      allow read: if isAuthenticated();\r\n      // WRITE: Only super admins can create, update, or delete schedules.\r\n      allow write: if isSuperAdmin();\r\n    }\r\n\r\n    // =================================================================\r\n    // Collection: medicalRecords\r\n    // Stores user medical records. Created and managed by admins.\r\n    // =================================================================\r\n    match /medicalRecords/{recordId} {\r\n      // READ: The patient (owner) or the admin of the barangay.\r\n      allow read: if isOwner(resource.data.userId) || isAdminOfBarangay(resource.data.barangayId);\r\n\r\n      // WRITE: Only admins of the corresponding barangay or super admins can create/update records.\r\n      allow write: if isAdminOfBarangay(request.resource.data.barangayId) || isSuperAdmin();\r\n\r\n      // DELETE: Disallowed.\r\n      allow delete: if false;\r\n    }\r\n\r\n    // =================================================================\r\n    // Collection: medicines (Global Inventory)\r\n    // Managed by Super Admins.\r\n    // =================================================================\r\n    match /medicines/{medicineId} {\r\n      // READ: Any authenticated user can see the list of all possible medicines.\r\n      allow read: if isAuthenticated();\r\n      // WRITE: Only Super Admins can add, update, or remove from the global list.\r\n      allow write: if isSuperAdmin();\r\n    }\r\n\r\n    // =================================================================\r\n    // Collection: rhuInventory (RHU/Barangay-specific Inventory)\r\n    // Managed by Admins for their own barangay.\r\n    // =================================================================\r\n    match /rhuInventory/{barangayId}/{medicineId} {\r\n      // READ: Users can read their own barangay's inventory. Admins can read their own. Super admins can read all.\r\n      allow read: if (isUserRole() && barangayId == getUserData(request.auth.uid).barangay) ||\r\n                     isAdminOfBarangay(barangayId) ||\r\n                     isSuperAdmin();\r\n\r\n      // WRITE: Only the admin of that barangay or a super admin can manage inventory.\r\n      allow write: if isAdminOfBarangay(barangayId) || isSuperAdmin();\r\n    }\r\n\r\n    // =================================================================\r\n    // Collection: announcements\r\n    // Managed by Admins and Super Admins.\r\n    // =================================================================\r\n    match /announcements/{announcementId} {\r\n      // READ: Users can read announcements from their barangay. Admins can read announcements from their barangay. Super admins can read all announcements.\r\n      allow read: if (isUserRole() && resource.data.barangay == getUserData(request.auth.uid).barangay) ||\r\n                     (isAdmin() && resource.data.barangay == request.auth.token.barangayId) ||\r\n                     isSuperAdmin();\r\n      \r\n      // CREATE: Admins can create announcements for their barangay. Super admins can create announcements for any barangay.\r\n      allow create: if (isAdmin() && request.resource.data.barangay == request.auth.token.barangayId) ||\r\n                       isSuperAdmin();\r\n      \r\n      // UPDATE: Admins can update announcements from their barangay. Super admins can update any announcement.\r\n      allow update: if (isAdmin() && resource.data.barangay == request.auth.token.barangayId) ||\r\n                       isSuperAdmin();\r\n      \r\n      // DELETE: Admins can delete announcements from their barangay. Super admins can delete any announcement.\r\n      allow delete: if (isAdmin() && resource.data.barangay == request.auth.token.barangayId) ||\r\n                       isSuperAdmin();\r\n    }\r\n\r\n    // =================================================================\r\n    // Collection: logs\r\n    // Stores system activity logs and notifications.\r\n    // =================================================================\r\n    match /logs/{logId} {\r\n      // READ: Users can read their own logs. Admins can read logs for users in their barangay. Super admins can read all logs.\r\n      allow read: if isOwner(resource.data.userId) ||\r\n                     (isAdmin() && resource.data.barangayId == request.auth.token.barangayId) ||\r\n                     isSuperAdmin();\r\n\r\n      // WRITE: Only allow writes through Cloud Functions or specific authorized processes.\r\n      // Client-side writes are restricted to prevent unauthorized log creation.\r\n      allow write: if false;\r\n    }\r\n  }\r\n}\r\n","name":"firestore.rules"}]},"createTime":"2025-08-31T15:43:57.019759Z","metadata":{"services":["cloud.firestore"]}}
