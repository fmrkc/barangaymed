rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions (mirroring firestore.rules)
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'admin';
    }

    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.role == 'superadmin';
    }

    function isAdminOfBarangay(barangayId) {
      return isAdmin() && request.auth.token.barangayId == barangayId;
    }

    // Announcement images:
    // Path: /announcements/{barangayId}/{announcementId}/{imageName}
    match /announcements/{barangayId}/{announcementId}/{imageName} {
      // READ: Anyone can view announcement images (public content).
      allow read: if true;

      // WRITE (Create, Update, Delete):
      // - Must be an admin of the corresponding barangay or a superadmin.
      // - File size must be less than 5MB.
      // - File must be an allowed image type.
      allow write: if (isAdminOfBarangay(barangayId) || isSuperAdmin())
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }

    // Other potential storage paths can be added here later.
    // Example for user profile pictures:
    // match /users/{userId}/profile-picture.jpg {
    //   allow read: if true;
    //   allow write: if request.auth.uid == userId;
    // }

    // User documents (e.g., ID, certificates)
    // Path: /user-documents/{userId}/{fileName}
    match /user-documents/{userId}/{fileName} {
      // READ: Only the owner can read their own documents.
      allow read: if isAuthenticated() && request.auth.uid == userId;

      // WRITE: Only the owner can upload, update, or delete their own documents.
      // - File size must be less than 5MB (matching client-side validation).
      // - File must be an allowed type (matching client-side validation).
      allow write: if isAuthenticated()
                    && request.auth.uid == userId
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/(jpeg|png|webp|gif)|application/pdf');
    }
  }
}
