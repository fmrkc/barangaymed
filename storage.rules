rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions for authentication and role checks
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.role == 'superadmin';
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'admin';
    }

    function isUser() {
      return isAuthenticated() && request.auth.token.role == 'user';
    }

    // Announcement images
    // Path: /announcements/{barangayId}/{announcementId}/{imageName}
    match /announcements/{barangayId}/{announcementId}/{imageName} {
      // READ: Anyone can view announcement images (public content)
      allow read: if true;

      // WRITE (Create, Update):
      // - Admins can write to their own barangay's announcements.
      // - Superadmins can write to any announcement.
      // - File size must be less than 5MB.
      // - File must be an allowed image type.
      allow create, update: if (isAdmin() && request.auth.token.barangayId == barangayId || isSuperAdmin())
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');

      // DELETE:
      // - Admins can delete images from their own barangay's announcements.
      // - Superadmins can delete any image.
      allow delete: if isAdmin() && request.auth.token.barangayId == barangayId || isSuperAdmin();
    }

    // User documents (e.g., ID, certificates)
    // Path: /user-documents/{userId}/{fileName}
    match /user-documents/{userId}/{fileName} {
      // READ: Only the owner can read their own documents.
      allow read: if isAuthenticated() && request.auth.uid == userId;

      // CREATE, UPDATE: Only the owner can upload/update their own documents.
      // - File size must be less than 5MB.
      // - File must be an allowed type.
      allow create, update: if isAuthenticated()
          && request.auth.uid == userId
          && request.resource.size < 5 * 1024 * 1024
          && request.resource.contentType.matches('image/(jpeg|png|webp|gif)|application/pdf');

      // DELETE:
      // - The owner of the document can delete it.
      // - An admin can delete documents of a user belonging to the same barangay.
      // - A superadmin can delete any document.
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }

    // User IDs (e.g., for registration)
    // Path: /user_ids/{userId}/{fileName}
          match /user_ids/{userId}/{fileName} {
            // READ: Only the owner can read their own documents.
            allow read: if isAuthenticated() && request.auth.uid == userId;
    
            // CREATE, UPDATE: Only the owner can upload/update their own documents.
            // - File size must be less than 5MB.
            // - File must be an allowed type.
                  allow create, update: if isAuthenticated()
                      && request.auth.uid == userId
                      && request.resource.size < 5 * 1024 * 1024
                      && request.resource.contentType.matches('image/(jpeg|png|webp|gif)|application/pdf');      // DELETE:
      // - The owner of the document can delete it.
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }

    // Medical history documents
    // Path: /medical-history/{userId}/{fileName}
    match /medical-history/{userId}/{fileName} {
      // READ: Only the owner can read their own documents.
      allow read: if request.auth != null && request.auth.uid == userId;

      // WRITE: Only the owner can write their own documents, with size and type checks.
      allow write: if request.auth != null && request.auth.uid == userId
                && request.resource.size < 5 * 1024 * 1024
                && request.resource.contentType.matches('image/(jpeg|png)');
    }

    // Prescription uploads
    // Path: /prescriptions/{userId}/{fileName}
    match /prescriptions/{userId}/{fileName} {
      // READ: Only the owner can read their own prescriptions.
      allow read: if isAuthenticated() && request.auth.uid == userId;

      // WRITE: Only the owner can upload their own prescriptions.
      allow write: if isAuthenticated()
          && request.auth.uid == userId
          && request.resource.size < 5 * 1024 * 1024
          && request.resource.contentType.matches('image/(jpeg|png|webp|gif)|application/pdf');
    }

    // Prescriptions from teleconsultation, uploaded by admins/superadmins
    match /prescriptions/teleconsultation/{requestId}/{fileName} {
      // READ: The user associated with the request, admins, and superadmins can read.
      allow read: if isAdmin() || isSuperAdmin() || (isUser() && get(/databases/$(database)/documents/teleconsultationRequests/$(requestId)).data.userId == request.auth.uid);

      // WRITE (Create, Update): Admins and Superadmins can upload prescriptions.
      allow write: if (isAdmin() || isSuperAdmin())
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*|application/pdf');

      // DELETE: Admins and Superadmins can delete prescriptions.
      allow delete: if isAdmin() || isSuperAdmin();
    }
  }
}